# ==============================================================================
# DHANUSH REDDY PORTFOLIO - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in production or configure these variables in Render dashboard
# DO NOT COMMIT YOUR REAL .env FILE WITH PASSWORDS TO GITHUB
# ==============================================================================

# Flask Settings
FLASK_DEBUG=false
SECRET_KEY=generate-a-strong-random-secret-key-for-production
PORT=5000

# CORS Frontend Origin (e.g. https://dhanush-portfolio.vercel.app or http://localhost:5500)
FRONTEND_ORIGIN=*

# Target Recipient Email
MAIL_RECIPIENT=dr114547@gmail.com

# SMTP Delivery Configuration (e.g. Gmail App Password, SendGrid, Mailgun, Brevo)
# For Gmail SMTP:
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-16-char-google-app-password
# MAIL_SENDER=your-email@gmail.com
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=

# Dev Mode
# When true, emails are safely logged to the console/log without requiring live SMTP credentials.
# Set to false in production once SMTP credentials have been entered.
DEV_MODE=true

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=900
